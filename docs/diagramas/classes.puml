@startuml classes
title Diagrama de Classes - Domínio
skinparam shadowing false
skinparam dpi 130
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F5F9FF
  BorderColor #3A6EA5
}
hide empty members

package "Enumerações" #FDFDFD {
  enum Perfil {
  CLIENTE
  AGENTE
}
  enum TipoAgente {
  EMPRESA
  BANCO
}
  enum StatusPedido {
  EM_ANALISE
  APROVADO
  REPROVADO
  CANCELADO
  CONTRATO_EM_EXECUCAO
}
  enum Parecer {
  APROVADO
  REPROVADO
}
  enum SituacaoCredito {
  SOLICITADO
  APROVADO
  ATIVO
  QUITADO
  CANCELADO
}
}

interface Proprietario <<interface>>

abstract class Usuario {
  - id : String
  - nome : String
  - email : String
  - senhaHash : String
  - perfil : Perfil
  + autenticar(senha : String) : boolean
}

class Cliente {
  - cpf : String
  - rg : String
  - endereco : String
  - profissao : String
  + adicionarRendimento(r : Rendimento) : void
}

class Agente {
  - cnpj : String
  - endereco : String
  - tipo : TipoAgente
  + ehBanco() : boolean
}

class Rendimento {
  - entidadeEmpregadora : String
  - valor : double
}

class Automovel {
  - id : String
  - marca : String
  - modelo : String
  - ano : int
  - placa : String
  - matricula : String
}

class PedidoAluguel {
  - id : String
  - dataCriacao : Date
  - dataInicio : Date
  - dataFim : Date
  - status : StatusPedido
  + editar(dados) : void
  + cancelar() : void
  + registrarAvaliacao(a : AvaliacaoFinanceira) : void
  + executar() : void
}

class AvaliacaoFinanceira {
  - id : String
  - dataAnalise : Date
  - parecer : Parecer
  - observacao : String
}

class ContratoCredito {
  - id : String
  - valorFinanciado : double
  - prazoMeses : int
  - situacao : SituacaoCredito
}

Usuario <|-- Cliente
Usuario <|-- Agente
Proprietario <|.. Cliente
Proprietario <|.. Agente

Cliente "1" *-- "0..3" Rendimento : possui
Automovel "*" --> "1" Proprietario : proprietário atual
Cliente "1" <-- "*" PedidoAluguel : solicitado por
PedidoAluguel "*" --> "1" Automovel : aluga
PedidoAluguel "*" --> "0..1" Agente : analisado por
PedidoAluguel "1" --> "0..1" AvaliacaoFinanceira : recebe
AvaliacaoFinanceira "*" --> "1" Agente : realizada por
PedidoAluguel "1" --> "0..1" ContratoCredito : financiado por
ContratoCredito "*" --> "1" Agente : concedido por

note bottom of ContratoCredito : {agente.tipo = BANCO}  (RN07)
note bottom of Rendimento : {no máximo 3 por cliente}  (RN06)
note bottom of AvaliacaoFinanceira : {agente.perfil = AGENTE}  (RN04, RN05)
@enduml
