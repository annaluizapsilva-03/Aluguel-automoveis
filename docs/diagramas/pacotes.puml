@startuml pacotes
title Diagrama de Pacotes - Visão lógica (MVC)
skinparam shadowing false
skinparam dpi 130
skinparam packageStyle folder
skinparam package {
  BackgroundColor #F5F9FF
  BorderColor #3A6EA5
}

package "Visão (View)" as VIEW {
  package "views\n(templates EJS)" as VIEWS
  package "public\n(CSS, JS, imagens)" as PUBLIC
}
package "Controle (Controller)" as CTRL {
  package "routes" as ROUTES
  package "middlewares\n(autenticação e perfil)" as MID
  package "controllers" as CONTROLLERS
}
package "Modelo (Model)" as MODEL {
  package "services\n(regras de negócio)" as SERVICES
  package "models\n(schemas Mongoose)" as MODELS
}
package "Infraestrutura" as INFRA {
  package "config\n(conexão e variáveis)" as CONFIG
}
database "MongoDB" as DB

ROUTES --> MID
ROUTES --> CONTROLLERS
CONTROLLERS --> SERVICES
CONTROLLERS --> VIEWS : renderiza
SERVICES --> MODELS
MODELS --> CONFIG
CONFIG --> DB
VIEWS ..> PUBLIC
@enduml
